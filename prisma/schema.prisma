generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  SOLD_OUT
  POSTPONED
  CANCELLED
  COMPLETED
  PENDING_REVIEW
  REJECTED
}

enum EventSourceType {
  MANUAL
  API
  RSS
  WEB
  OTHER
}

enum RawEventStatus {
  DISCOVERED
  PROCESSING
  NORMALIZED
  FAILED
  IGNORED
}

enum IngestionRunStatus {
  RUNNING
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
  BLOCKED
}

enum RobotsStatus {
  ALLOWED
  DISALLOWED
  UNKNOWN
}

enum DuplicateDecisionType {
  KEEP_SEPARATE
  IGNORED
}

enum Discipline {
  RUN
  BIKE
  SWIM
  WALK
  ROW
  OTHER
}

model Country {
  id     String  @id @default(cuid())
  name   String
  code   String  @unique
  states State[]
  @@index([name])
}

model State {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cities    City[]
  @@unique([countryId, name])
  @@index([countryId])
}

model City {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  stateId   String
  state     State   @relation(fields: [stateId], references: [id], onDelete: Restrict)
  venues    Venue[]
  events    Event[]
  aliases   CityAlias[]
  @@index([stateId])
}

model CityAlias {
  id        String   @id @default(cuid())
  alias     String   @unique
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([cityId])
}

model Venue {
  id        String  @id @default(cuid())
  name      String
  address   String?
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  cityId    String
  city      City    @relation(fields: [cityId], references: [id], onDelete: Restrict)
  events    Event[]
  @@index([cityId])
}

model Organizer {
  id          String  @id @default(cuid())
  name        String
  websiteUrl  String?
  description String?
  events      Event[]
  @@index([name])
}

model EventCategory {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique
  parentId  String?
  parent    EventCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  EventCategory[] @relation("CategoryTree")
  events    Event[]
  @@index([parentId])
}

model Event {
  id                String       @id @default(cuid())
  name              String
  slug              String       @unique
  description       String       @db.Text
  organizerId       String?
  organizer         Organizer?   @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  venueId           String?
  venue             Venue?       @relation(fields: [venueId], references: [id], onDelete: SetNull)
  cityId            String
  city              City         @relation(fields: [cityId], references: [id], onDelete: Restrict)
  categoryId        String
  category          EventCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  startDate         DateTime     @db.Date
  endDate           DateTime?    @db.Date
  registrationUrl   String?
  officialWebsiteUrl String?
  sourceName        String?
  sourceUrl         String?
  lastVerifiedAt    DateTime?
  status            EventStatus  @default(DRAFT)
  isDemo            Boolean      @default(false)
  distances         EventDistance[]
  sourceRecords     EventSourceRecord[]
  rawEvents         RawEvent[]
  duplicateKey      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  @@index([startDate, status])
  @@index([cityId, startDate])
  @@index([categoryId, startDate])
  @@index([status])
  @@index([duplicateKey])
}

model EventDistance {
  id         String     @id @default(cuid())
  eventId    String
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name       String
  discipline Discipline @default(OTHER)
  distanceKm Decimal?   @db.Decimal(8, 3)
  sequence   Int        @default(0)
  @@index([eventId, sequence])
}

model EventSource {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  type          EventSourceType
  baseUrl       String?
  enabled       Boolean         @default(false)
  crawlDepth    Int             @default(2)
  maxPagesPerRun Int            @default(50)
  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  records       EventSourceRecord[]
  rawEvents     RawEvent[]
  runs          IngestionRun[]
  @@index([enabled])
}

model EventSourceRecord {
  id          String      @id @default(cuid())
  eventId     String
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sourceId    String
  source      EventSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  externalId  String?
  sourceUrl   String?
  registrationUrl String?
  officialWebsiteUrl String?
  lastVerifiedAt DateTime?
  originalTitle String?
  rawPayload    Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  @@unique([sourceId, externalId])
  @@index([eventId])
  @@index([sourceId])
}

model RawEvent {
  id            String         @id @default(cuid())
  sourceId      String
  source        EventSource    @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  eventId       String?
  event         Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  externalId    String?
  sourceUrl     String?
  rawPayload    Json
  contentHash   String
  discoveredAt  DateTime       @default(now())
  processedAt   DateTime?
  status        RawEventStatus @default(DISCOVERED)
  errorMessage  String?        @db.Text
  validationErrors Json?
  @@unique([sourceId, contentHash])
  @@index([sourceId])
  @@index([externalId])
  @@index([status, discoveredAt])
  @@index([eventId])
}

model IngestionRun {
  id                String            @id @default(cuid())
  sourceId          String
  source            EventSource       @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  startedAt         DateTime          @default(now())
  completedAt       DateTime?
  status            IngestionRunStatus @default(RUNNING)
  robotsStatus      RobotsStatus?
  robotsReason      String?           @db.Text
  recordsDiscovered Int               @default(0)
  recordsCreated    Int               @default(0)
  recordsUpdated    Int               @default(0)
  recordsRejected   Int               @default(0)
  duplicatesFound   Int               @default(0)
  errorMessage      String?           @db.Text
  @@index([sourceId, startedAt])
  @@index([status])
}

model DuplicatePairDecision {
  id        String               @id @default(cuid())
  pairKey   String               @unique
  decision  DuplicateDecisionType
  createdAt DateTime             @default(now())
  @@index([decision])
}

model UserProfile {
  id        String   @id @db.Uuid
  email     String?  @unique
  username  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
